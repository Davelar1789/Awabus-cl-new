# EXPO_PUBLIC_ vars are inlined into the JS bundle at build time by Expo/Metro
# (see https://docs.expo.dev/guides/environment-variables/) — copy this file to
# .env and point it at your running server. On a physical device this must be
# your computer's LAN IP (or the deployed server URL), not localhost.
EXPO_PUBLIC_API_URL=http://localhost:5000/api
